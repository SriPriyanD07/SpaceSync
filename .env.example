# ==========================================
# SpaceSync - Root Environment Configuration Template
# ==========================================

# 1. Authoritative Neon PostgreSQL Connection String (Required for Production & DA3 Load Balancing)
# Paste your Neon PostgreSQL connection string here. Docker Compose will automatically inject it into all 3 instances.
# Example: postgresql://spacesync_owner:npg_SecretPass@ep-cool-fog-123456.us-east-2.aws.neon.tech/spacesync?sslmode=require
DATABASE_URL=

# 2. DA3 Nginx Reverse Proxy / Load Balancer Port
# Port 8080 is the default. If port 8080 is occupied by a host service (such as Oracle XML DB / TNSLSNR),
# you can either stop that service or set NGINX_PORT to another port (e.g. 8081).
NGINX_PORT=8080

# 3. Connection Pooling Limits per Instance
# Neon free tier allows up to 20-30 connections. 3 instances * 7 connections = 21 max connections.
DB_POOL_MAX=7
ALLOW_EMBEDDED_DB=false

# 4. Security & Authentication
JWT_SECRET=spacesync_production_jwt_secret_key_change_in_prod_2026
JWT_EXPIRES_IN=7d

# 5. Application Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api
