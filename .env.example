# ==========================================
# SpaceSync - Root Environment Configuration Template
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (Local Docker, Neon, Supabase, Render, Railway)
# Example Local Docker: postgres://spacesync_user:spacesync_password@localhost:5432/spacesync_db
# Example Neon: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/spacesync?sslmode=require
DATABASE_URL=postgres://spacesync_user:spacesync_password@localhost:5432/spacesync_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# DA3 / Docker Compose Multi-Instance Load Balancing Configuration
# Sensible connection pool limit per instance to avoid exhausting Neon connection limit (3 instances * 7 = 21 connections max)
DB_POOL_MAX=7
ALLOW_EMBEDDED_DB=false

# Frontend & Nginx Proxy Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
