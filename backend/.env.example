# SpaceSync Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgres://spacesync_user:spacesync_password@localhost:5432/spacesync_db
# Security & Authentication Configuration (min 32 characters for production)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
MFA_ENCRYPTION_KEY=replace_with_a_valid_32_byte_key
JWT_EXPIRES_IN=7d
